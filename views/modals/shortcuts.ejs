                <div class="shortcut-card">
                    <span class="shortcut-card-title">🗣️ Озвучити результат голосом</span>
                    <span class="shortcut-key-badge">V</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">🕒 Відкрити історію</span>
                    <span class="shortcut-key-badge">H</span>
                </div>
