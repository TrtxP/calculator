    <div class="modal-overlay" id="shortcuts-modal">
        <div class="modal-content">
            <span class="sheet-drag-handle"></span>
            <h3>⌨️ Гарячі клавіші (v1.8.6 Ultra)</h3>
            <div class="shortcuts-grid">
                <div class="shortcut-card">
                    <span class="shortcut-card-title">⚡ Швидкий пошук (Command Palette)</span>
                    <span class="shortcut-key-badge">Ctrl + K</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">📖 Довідник гарячих клавіш</span>
                    <span class="shortcut-key-badge">F1 / ?</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">⛶ Повноекранний режим Focus</span>
                    <span class="shortcut-key-badge">F11</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">⌫ Стерти останній символ / функцію</span>
                    <span class="shortcut-key-badge">Backspace</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">🗑️ Повне очищення дисплея</span>
                    <span class="shortcut-key-badge">Escape</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">🟰 Обчислити результат</span>
                    <span class="shortcut-key-badge">Enter / =</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">📋 Скопіювати результат</span>
                    <span class="shortcut-key-badge">Ctrl + C</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">📥 Вставити число з буфера</span>
                    <span class="shortcut-key-badge">Ctrl + V</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">🔄 Перемкнути 2nd (Shift)</span>
                    <span class="shortcut-key-badge">S</span>
                </div>
                <div class="shortcut-card">
                    <span class="shortcut-card-title">📐 Перемкнути DEG / RAD / GRAD</span>
                    <span class="shortcut-key-badge">D</span>
