                <div class="display" onclick="copyToClipboard()" title="Натисніть, щоб скопіювати результат у буфер">
                    <div class="display-header">
                        <div class="display-badges">
                            <span class="display-led-status" title="Калькулятор активний"></span>
                            <span class="command-badge" id="command-badge" onclick="event.stopPropagation(); openCommandPalette();" title="Швидкий пошук інструментів (Ctrl+K)">⚡ Пошук</span>
                            <span class="mode-badge" id="mode-badge" onclick="event.stopPropagation(); toggleAngleMode();" title="Натисніть для зміни DEG / RAD / GRAD">DEG</span>
                            <span class="secondary-badge" id="secondary-badge" onclick="event.stopPropagation(); toggleSecondMode();" title="Режим додаткових функцій (2nd / Shift)">2nd</span>
                            <span class="memory-badge" id="memory-badge" onclick="event.stopPropagation(); openModal('memory-modal');" title="Матриця пам'яті M1-M4">M</span>
                            <span class="audio-badge" id="audio-badge" onclick="event.stopPropagation(); cycleSoundProfile();" title="Перемкнути профіль звуку">🔊</span>
                        </div>
                        <div class="history-line" id="history-line"></div>
                    </div>
                    <div class="current-line" id="display">0</div>
                    <div class="display-footer">
                        <span class="copy-tooltip">📋 Клік — копіювати</span>
                        <div class="display-footer-meta">
                            <span class="separator-indicator" id="separator-tag" onclick="event.stopPropagation(); cycleSeparatorFormat();" title="Формат розділювача тисяч (Пробіл / Кома / Без)">Розряди: Пробіл</span>
                            <span class="precision-indicator" id="precision-tag" onclick="event.stopPropagation(); cyclePrecision();" title="Точність округлення (Auto / 0..12)">Auto</span>
                        </div>
                    </div>
                </div>
